{
  "server": {
    "port": 443,
    "host": "0.0.0.0",
    "ssl": true,
    "domain": "",
    "autoRenewCert": true,
    "maxRequestSize": "500mb",
    "heartbeatInterval": 15000,
    "memoryThreshold": 50
  },
  "rotation": {
    "strategy": "round_robin",
    "requestCount": 50
  },
  "log": {
    "maxSizeMB": 10,
    "maxFiles": 5,
    "maxMemory": 500
  },
  "api": {
    "use": "production"
  },
  "defaults": {
    "temperature": 1,
    "topP": 1,
    "topK": 50,
    "maxTokens": 32000,
    "thinkingBudget": 16000
  },
  "cache": {
    "modelListTTL": 3600000
  },
  "models": {
    "allowlist": [
      "gemini-4-argon-high",
      "gemini-4-argon-medium",
      "gemini-4-argon-low",
      "gemini-3.8-flash-high",
      "gemini-3.8-flash-medium",
      "gemini-3.8-flash-low",
      "gemini-3.8-flash-tiered",
      "claude-opus-5-5-high",
      "claude-opus-5-5-medium",
      "claude-opus-5-5-low",
      "claude-sonnet-5-5-high",
      "claude-sonnet-5-5-medium",
      "claude-sonnet-5-5-low",
      "gpt-oss-120b-medium"
    ]
  },
  "inputTokenGuard": {
    "enabled": true,
    "limit": 1048576,
    "warnRatio": 0.9,
    "safetyRatio": 0.1,
    "signatureCharsPerToken": 1.7,
    "imageTokenEstimate": 1300
  },
  "other": {
    "timeout": 300000,
    "retryTimes": 10,
    "retryIntervalMs": 10000,
    "retryPollTokenWithQuota": false,
    "forceIPv4": false,
    "skipProjectIdFetch": false,
    "useNativeAxios": false,
    "useContextSystemPrompt": false,
    "officialPromptPosition": "before",
    "mergeSystemPrompt": false,
    "passSignatureToClient": false,
    "useFallbackSignature": false,
    "cacheAllSignatures": false,
    "cacheToolSignatures": true,
    "cacheImageSignatures": true,
    "cacheThinking": true,
    "fakeNonStream": false,
    "alwaysUseCredits": false
  }
}
